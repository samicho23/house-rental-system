// House and Apartment Rental System - Database Schema
// Entities: users, properties, photos, applications, leases, payments,
// maintenance requests, notifications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Roles
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  // Fayda national ID stable identifier - links account to verified identity
  faydaId      String?  @unique
  faydaVerified Boolean @default(false)
  email        String   @unique
  phone        String?
  password     String   // scrypt hash
  firstName    String
  lastName     String
  gender       String?
  dateOfBirth  String?
  city         String?
  subCity      String?
  role         String   @default("TENANT") // TENANT | LANDLORD | ADMIN
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties     Property[]
  applications   Application[]
  leases         Lease[]       @relation("LeaseTenant")
  ownedLeases    Lease[]       @relation("LeaseLandlord")
  paymentsRecorded Payment[]   @relation("PaymentRecorder")
  maintenance    MaintenanceRequest[] @relation("MaintenanceTenant")
  assignedMaintenance MaintenanceRequest[] @relation("MaintenanceLandlord")
  notifications  Notification[]
  auditLogs      AuditLog[]       @relation("AuditActor")
  newsArticles   NewsArticle[]    @relation("NewsAuthor")
}

// ---------------------------------------------------------------------------
// Properties & Photos
// ---------------------------------------------------------------------------
model Property {
  id            String   @id @default(cuid())
  landlordId    String
  landlord      User     @relation(fields: [landlordId], references: [id])
  title         String
  description   String
  propertyType  String   @default("APARTMENT") // HOUSE | APARTMENT | CONDO | SINGLE_ROOM | STUDIO
  listingType   String   @default("RENT") // RENT | LEASE
  city          String
  subCity       String?
  address       String?
  price         Float
  currency      String   @default("ETB")
  pricePeriod   String   @default("MONTH") // MONTH
  bedrooms      Int      @default(1)
  bathrooms     Int      @default(1)
  areaSqm       Int?
  furnished     Boolean  @default(false)
  hasParking    Boolean  @default(false)
  hasWater      Boolean  @default(true)
  amenities     String?  // comma separated amenity list
  status        String   @default("PUBLISHED") // DRAFT | PUBLISHED | UNPUBLISHED | RENTED
  approvalStatus String  @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason String?
  availableFrom DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  photos       PropertyPhoto[]
  applications Application[]
  leases       Lease[]
  maintenance  MaintenanceRequest[]

  @@index([city])
  @@index([status, approvalStatus])
  @@index([landlordId])
}

model PropertyPhoto {
  id         String  @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  isCover    Boolean @default(false)
  order      Int     @default(0)
}

// ---------------------------------------------------------------------------
// Rental Applications
// ---------------------------------------------------------------------------
model Application {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  tenantId   String
  tenant     User     @relation(fields: [tenantId], references: [id])
  message    String?
  moveInDate DateTime?
  occupants  Int      @default(1)
  phone      String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | WITHDRAWN
  decisionNote String?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lease Lease?

  @@unique([propertyId, tenantId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Leases
// ---------------------------------------------------------------------------
model Lease {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  tenantId    String
  tenant      User     @relation("LeaseTenant", fields: [tenantId], references: [id])
  landlordId  String
  landlord    User     @relation("LeaseLandlord", fields: [landlordId], references: [id])
  applicationId String? @unique
  application   Application? @relation(fields: [applicationId], references: [id])
  startDate     DateTime
  endDate     DateTime
  monthlyRent Float
  deposit     Float    @default(0)
  paymentDay  Int      @default(5) // day of month rent is due
  status      String   @default("ACTIVE") // ACTIVE | ENDED | PENDING
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments     Payment[]
  maintenance  MaintenanceRequest[]

  @@index([tenantId])
  @@index([landlordId])
}

// ---------------------------------------------------------------------------
// Payments (append-only ledger recorded by landlord)
// ---------------------------------------------------------------------------
model Payment {
  id            String   @id @default(cuid())
  leaseId       String
  lease         Lease    @relation(fields: [leaseId], references: [id])
  amount        Float
  currency      String   @default("ETB")
  dueDate       DateTime
  paidDate      DateTime?
  method        String   @default("CASH") // CASH | BANK_TRANSFER | MOBILE_MONEY | CHEQUE
  status        String   @default("PENDING") // PENDING | PAID | OVERDUE
  periodLabel   String?  // e.g. "2026-10"
  note          String?
  recordedById  String
  recordedBy    User     @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leaseId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Maintenance Requests
// ---------------------------------------------------------------------------
model MaintenanceRequest {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  leaseId     String?
  lease       Lease?   @relation(fields: [leaseId], references: [id])
  tenantId    String
  tenant      User     @relation("MaintenanceTenant", fields: [tenantId], references: [id])
  landlordId  String
  landlord    User     @relation("MaintenanceLandlord", fields: [landlordId], references: [id])
  title       String
  description String
  category    String   @default("GENERAL") // PLUMBING | ELECTRICAL | WATER | STRUCTURAL | GENERAL
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  response    String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([landlordId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// In-app Notifications
// ---------------------------------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO") // APPLICATION | LEASE | PAYMENT | MAINTENANCE | ADMIN | INFO
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Contact form messages
// ---------------------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW") // NEW | READ | RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// News articles
// ---------------------------------------------------------------------------
model NewsArticle {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  summary       String?
  content       String
  coverImageUrl String?
  status        String   @default("DRAFT") // DRAFT | PUBLISHED
  authorId      String?
  author        User?    @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}
